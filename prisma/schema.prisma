generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Physio {
  id     String  @id @default(uuid())
  name   String
  quotes Quote[]
}

model Client {
  id      String  @id @default(uuid())
  name    String
  contact String
  quotes  Quote[]
}

model Quote {
  id        String   @id @default(uuid())
  physio_id String
  client_id String
  startDate DateTime
  endDate   DateTime
  status    String
  client    Client   @relation(fields: [client_id], references: [id])
  physio    Physio   @relation(fields: [physio_id], references: [id])
}
